# ===========================================================================
# Business 4.0 server — environment.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ===========================================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed by CORS (the Vite dev server, prod site).
CLIENT_ORIGIN=http://localhost:5173

# ---- Neon (Postgres) ----
# From the Neon dashboard → Connection Details → "Connection string" (pooled).
# Keep ?sslmode=require — Neon only accepts TLS connections.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# ---- Auth (JSON Web Tokens) ----
# Generate a long random string, e.g. `openssl rand -hex 48`.
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=10

# ---- Cloudinary (image hosting) ----
# From the Cloudinary dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder every upload is namespaced under, so this project's assets stay tidy.
CLOUDINARY_FOLDER=business4

# ---- Admin bootstrap (used by `npm run db:seed`) ----
# The first admin account, so someone can reach the admin endpoints on a fresh db.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@business4.com
ADMIN_PASSWORD=change-this-before-seeding
