# Optional. Without it the map falls back to the keyless embed endpoint,
# which works but is undocumented and unsupported by Google.
# Get one at https://console.cloud.google.com/ -> enable "Maps Embed API".
# Restrict the key by HTTP referrer before deploying , it ships to the client.
VITE_GOOGLE_MAPS_API_KEY=

# Base URL of the backend API (server/). Defaults to "/api" (same origin,
# e.g. behind a Vite proxy or a reverse proxy in production). Point it at the
# server directly during local dev, e.g. http://localhost:4000/api.
# NOTE: the app does not talk to the backend yet — this only configures the
# axios client in src/api/ for when the contexts are wired up.
VITE_API_URL=
